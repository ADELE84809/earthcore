{
  "name": "earthcore",
  "version": "1.0.0",
  "private": true,
  "description": "EarthCore — a planetary intelligence platform for exploring real environmental data.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/copy-worker.mjs && next dev --port 3000",
    "build": "node scripts/copy-worker.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "node scripts/copy-worker.mjs"
  },
  "dependencies": {
    "@types/topojson-client": "^3.1.5",
    "geist": "^1.5.1",
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.5.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
